# Publishers and resolvers that reject automated clients with 403 even though
# the links resolve in a browser. Excluded so the weekly lychee run reflects
# real breakage rather than bot blocking.
^https://doi\.org/
^https://www\.iso\.org/

# FHR-Nextflow is currently a private repository, so it 404s for anonymous
# visitors and link checkers. Remove this exclusion once the repository is
# public; until then the public link is expected to fail for outside users.
^https://github\.com/FAIR-bioHeaders/FHR-Nextflow
