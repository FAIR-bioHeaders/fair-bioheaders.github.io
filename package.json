{
  "name": "fair-bioheaders-site",
  "version": "1.0.0",
  "description": "FAIR BioHeaders project website",
  "repository": {
    "type": "git",
    "url": "https://github.com/fair-bioheaders/fair-bioheaders.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Adam Wright",
    "David Molik"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fair-bioheaders/fair-bioheaders.github.io/issues"
  },
  "homepage": "https://fair-bioheaders.github.io",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jquery": "3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.fitvids.js assets/js/plugins/jquery.greedy-navigation.js assets/js/plugins/jquery.magnific-popup.js assets/js/plugins/stickyfill.min.js assets/js/_main.js assets/js/cite.js -c -m -o assets/js/main.min.js",
    "build:js": "npm run uglify",
    "test:browser": "playwright test",
    "test:deploy": "python3 scripts/check_deployed.py"
  },
  "private": true
}
